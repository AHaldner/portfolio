---
import { Image } from 'astro:assets';
import Layout from '@layouts/Layout.astro';
import scaredKitten from '@assets/scared-still.webp';

const pageTitle = '404';
---

<Layout title={pageTitle}>
    <div class="not-found">
        <Image
            src={scaredKitten}
            alt="A scared kitten with wet eyes"
            width={136}
            height={128}
            loading="eager"
        />
        <h1>404 - Page Not Found</h1>
        <p>Oops! The page you're looking for doesn't exist.</p>
        <a href="/">Take me back home</a>
    </div>
</Layout>

<style lang="scss">
    .not-found {
        text-align: center;
    }
</style>
