---
import '@styles/global.scss';
import '@styles/fonts.css';

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import normalFont from '@assets/fonts/jetbrainsmono.woff2?url';

interface Props {
    title?: string;
}

const { title } = Astro.props;

const pageTitle = title ? title + ' | tihn.dev' : 'tihn.dev';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Backend-leaning web developer learning Rust and building tools."
        />
        <meta name="viewport" content="width=device-width" />
        <meta name="theme-color" content="#1a1b26" />
        <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
        <link rel="preload" href={normalFont} as="font" type="font/woff2" crossorigin="anonymous" />
        <title>{pageTitle}</title>
    </head>
    <body>
        <a class="skip-link" href="#main-content">
            Skip to main content
        </a>
        <Header />
        <main id="main-content" class="content" tabindex="-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style lang="scss">
    .skip-link {
        position: fixed;
        inset-block-start: 1rem;
        inset-inline-start: 1rem;
        z-index: 10;
        padding: 0.75rem 1rem;
        background: var(--bg-color);
        border: 2px solid currentColor;
        text-decoration: underline;

        &:not(:focus-visible) {
            clip-path: inset(50%);
            overflow: hidden;
            inline-size: 1px;
            block-size: 1px;
            padding: 0;
            border: 0;
            white-space: nowrap;
        }
    }

    .content {
        max-width: var(--content-width);
        margin: auto;
        padding: 2rem 0;
    }
</style>
