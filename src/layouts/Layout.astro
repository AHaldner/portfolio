---
import '@styles/global.scss';

import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
    title?: string;
}

const { title } = Astro.props;

const pageTitle = title ? title + ' | tihn.dev' : 'tihn.dev';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Backend-leaning web developer learning Rust and building tools."
        />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.png" />
        <title>{pageTitle}</title>
    </head>
    <body>
        <Header />
        <div class="content">
            <slot />
        </div>
        <Footer />
    </body>
</html>

<style lang="scss">
    .content {
        max-width: var(--content-width);
        margin: auto;
        padding: 2rem 0;
    }
</style>
