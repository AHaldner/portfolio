---
import Social from './Social.astro';
---

<footer>
    <div class="footer-socials">
        <Social platform="github.com" username="AHaldner" />
        <Social platform="bsky.app" username="profile/tihn.dev" />
        <Social platform="npmjs.com" username="~tihn" />
    </div>
</footer>

<style lang="scss">
    footer {
        max-width: var(--content-width);
        margin: auto;
    }

    .footer {
        &-socials {
            display: flex;
            flex-direction: row;
            gap: 20px;
        }
    }
</style>
