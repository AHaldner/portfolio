---
import Navigation from '@components/Navigation.astro';

const pageName = 'tihn.dev';
---

<header>
    <nav>
        <a href="/">
            <span>{pageName}</span>
        </a>
        <Navigation />
    </nav>
</header>

<style lang="scss">
    nav {
        max-width: var(--content-width);
        margin: auto;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;

        span {
            font-weight: 700;
        }
    }
</style>
