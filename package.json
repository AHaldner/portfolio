{
    "name": "tihn.dev",
    "type": "module",
    "version": "1.0.0",
    "packageManager": "bun@1.4.4",
    "engines": {
        "node": "^22.23.4 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "vp run check:astro && astro build",
        "preview": "astro preview",
        "astro": "astro",
        "check": "vp check && tsc --noEmit && vp run check:astro",
        "check:astro": "astro sync && vpx scripts/check-astro.ts",
        "typecheck": "tsc --noEmit",
        "lint": "vp lint",
        "fmt": "vp fmt",
        "prepare": "vp config"
    },
    "dependencies": {
        "astro": "7.4.12",
        "sass": "^1.108.2",
        "typescript": "^7.0.2"
    },
    "devDependencies": {
        "@astrojs/language-server": "^2.17.3",
        "@tihn/bun-guard": "^1.4.2",
        "@types/node": "22",
        "typescript-astro": "npm:typescript@^6.0.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
        "vite-plus": "1.7.0"
    },
    "overrides": {
        "picomatch": ">=2.3.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
    }
